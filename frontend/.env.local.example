# =============================================================================
# Google Gemini API Keys (Pool con Failover Automático por Límite de Cuota)
# =============================================================================
GEMINI_API_KEYS=AIzaSyLlave1_xxxxxxxxxxxxxxxxxxxx,AIzaSyLlave2_xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyLlave1_xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Motor de Voz Neuronal: ElevenLabs
# =============================================================================
# Genera tu clave en: https://elevenlabs.io
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Almacenamiento Gratuito de Activos: Cloudinary (Retratos & Audios MP3)
# =============================================================================
# Regístrate en https://cloudinary.com (Tier gratuito generoso)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# =============================================================================
# Orquestación de Video Lip-Sync: OpenRouter (heygen/avatar-iv)
# =============================================================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Claude con tu suscripción (modo "Claude · mi suscripción" del selector IA)
# Usa Claude Code instalado en este PC con la sesión iniciada (`claude` → /login).
# No hace falta clave. Ambas variables son opcionales.
# =============================================================================
# CLAUDE_CODE_MODEL=sonnet          # sonnet | opus | haiku (según lo que incluya tu plan)
# CLAUDE_CLI_PATH=                  # ruta a claude/claude.exe si la app no lo encuentra sola
# Chat "Claude · editor" (Edición de video): Claude ejecuta comandos aislado (macOS/Linux).
# LULO_CLAUDE_DOMINIOS=cdn.ejemplo.com,otro.sitio.com   # dominios extra para descargas
# LULO_CLAUDE_BASH_SIN_AISLAMIENTO=1   # SOLO Windows: deja a Claude ejecutar comandos SIN aislamiento

# =============================================================================
# ApiMart (Modelos Hailuo 2.3, Kling v3 Omni, Seedance)
# =============================================================================
APIMART_API_KEY=am_live_xxxxxxxxxxxxxxxxxxxx

# URLs locales
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# =============================================================================
# Buzzy (buzzy.now) vía MCP — pedir la URL y la clave a Buzzy
# =============================================================================
BUZZY_MCP_URL=
BUZZY_MCP_TOKEN=

# =============================================================================
# Carpeta de datos (opcional). Por defecto: %APPDATA%\LuloStudio en Windows.
# Aquí se guardan costos, trabajos de render y ajustes; no se borra al actualizar la app.
# =============================================================================
# LULO_DATA_DIR=
